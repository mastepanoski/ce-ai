{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "ce-ai workflow resume",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "ce-ai gate check",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "ce-ai workflow resume",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "ce-ai workflow resume",
            "type": "command"
          }
        ],
        "matcher": ".*"
      }
    ]
  }
}